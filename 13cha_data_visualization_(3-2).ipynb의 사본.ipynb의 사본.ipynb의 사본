   '지점 분석 행 수': f'{len(dg)}행', '평균': f'{평균:,.0f}원',\n","        '중앙값': f'{중앙값:,.0f}원', '최빈값': f'{최빈값:,.0f}원 ({최빈_건수}건)',\n","        '이상치 건수': f'{len(이상치)}건',\n","        '최대 주문': f'{큰거[\"주문번호\"]} · {큰거[\"판매금액(원)\"]:,.0f}원',\n","        '단가-수량 상관계수': f'{r:.3f}'}\n","\n","제목 = {'1-1':'실습 1-1 잘못된 시각화 판별', '2-1':'실습 2-1 대표값 확인',\n","        '2-2':'실습 2-2 평균이 같은 경우', '3-1_사전':'실습 3-1 사전 질문',\n","        '3-1':'실습 3-1 목적별 그래프 5종', '3-2':'실습 3-2 잘못된 조합',\n","        '4-1':'실습 4-1 해석 문장', '4-2':'실습 4-2 AI 검토'}\n","순번 = ['1-1','2-1','2-2','3-1_사전','3-1','3-2','4-1','4-2']\n","\n","def b64(p):\n","    with open(p, 'rb') as f: return base64.b64encode(f.read()).decode()\n","\n","# [수정 2] 사전 질문 섹션에는 그림을 붙이지 않음 → 3-1 중복 방지\n","def 관련그림(n):\n","    if n.endswith('_사전'): return []\n","    return [f for f in FIGURES if f['file'].startswith(n + '_')]\n","\n","작성일 = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')\n","H = [f'''<!DOCTYPE html><html lang=\"ko\"><head><meta charset=\"utf-8\">\n","<title>13차시 실습 결과 · {내_이름}</title><style>\n","body{{font-family:'Malgun Gothic',sans-serif;max-width:900px;margin:0 auto;\n","padding:40px 24px 80px;color:#152029;line-height:1.7;background:#F5F7F8}}\n","h1{{font-size:28px;border-bottom:3px solid #152029;padding-bottom:14px}}\n","h2{{font-size:20px;color:#0F4C5C;margin-top:44px;border-bottom:1px solid #D8DFE1;padding-bottom:8px}}\n","table{{width:100%;border-collapse:collapse;margin:14px 0;background:#fff;font-size:14px}}\n","th{{background:#EDF1F2;color:#0F4C5C;text-align:left;padding:10px 12px;width:30%;\n","border-bottom:1px solid #D8DFE1;vertical-align:top}}\n","td{{padding:10px 12px;border-bottom:1px solid #EAEFF0}}\n","img{{max-width:100%;border:1px solid #D8DFE1;border-radius:8px;background:#fff;margin:10px 0}}\n","figcaption{{font-size:13px;color:#5E7079;margin-bottom:20px}}\n","</style></head><body>\n","<h1>13차시 데이터 시각화 실습 결과</h1>\n","<p style=\"color:#5E7079\">{내_분반} · {내_이름} · {작성일}<br>원자료 {CSV_NAME} ({len(df)}행)</p>\n","<h2>자동 계산된