      ).to_csv(csv_path, index=False, encoding='utf-8-sig')\n","\n","최종zip = os.path.join(OUTDIR, f'{기본이름}_전체.zip')\n","with zipfile.ZipFile(최종zip, 'w', zipfile.ZIP_DEFLATED) as z:\n","    for f in FIGURES: z.write(f['path'], arcname=f'이미지/{f[\"file\"]}')\n","    for p in [html_path, md_path, csv_path]: z.write(p, arcname=os.path.basename(p))\n","\n","print(f'\\n✅ 완료 · 이미지 {len(FIGURES)}장 + 리포트 3종 ({os.path.getsize(최종zip)/1024:,.0f} KB)')\n","if IN_COLAB:\n","    files.download(최종zip)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":258},"id":"gBZV2UCqnN_C","executionInfo":{"status":"ok","timestamp":1785693426382,"user_tz":-540,"elapsed":130,"user":{"displayName":"김일주","userId":"12803008371470632829"}},"outputId":"519db993-bde6-4e68-a669-63d9573f32ff"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["미작성 7개\n","  · [4-1] 해석문장1_지점별막대\n","  · [4-1] 해석문장2_월별선\n","  · [4-1] 해석문장3_히스토그램\n","  · [4-1] 해석문장4_박스플롯\n","  · [4-1] 해석문장5_산점도\n","  · [4-2] 발견한_문제\n","  · [4-2] 수정후_달라진점\n","저장된 그래프 3장\n","\n","✅ 완료 · 이미지 3장 + 리포트 3종 (677 KB)\n"]},{"output_type":"stream","name":"stderr","text":["/usr/lib/python3.12/zipfile/__init__.py:1624: UserWarning: Duplicate name: '이미지/3-2_잘못된조합_3종.png'\n","  return self._open_to_write(zinfo, force_zip64=force_zip64)\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_713bf691-0876-4223-b64c-62a2b805732a\", \"13\\ucc28\\uc2dc_A\\ubc18_\\ud64d\\uae38\\ub3d9_20260802_\\uc804\\uccb4.zip\", 692778)"]},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"15c88e70"},"source":["# 카페 판매 데이터 분석 보고서\n","\n","## 📊 요약\n","본 보고서는 위세스 카페의 2026년 1월부터 6월까지의 판매 데이터를 분석한 결과입니다. 강남점이 총 판매금액에서 가장 높은 비중을 차지하며, 2월에서 3월로 넘어가는 시점에 월별 판매금액이 크게 급등한 것을 확인했습니다. 판매금액 분포를 보면 3,827원~26,325원 구간에 대부분의 판매가 집중되어 있으며, 각 지점별로 일부 이상치 판매 건이 존재합니다. 단가와 수량 간의 상관관계는 매우 낮아 두 변수 간 직접적인 선형 관계는 미미합니다."]},{"cell_type":"markdown","metadata":{"id":"21532bb8"},"source":["## 📈 상세 분석\n","\n","### 1. 지점별 총 판매금액\n","- **강남점:** 1,165,260원\n","- **마포점:** 886,220원\n","- **성수점:** 659,805원\n","\n","강남점의 판매금액이 가장 높으며, 1위 지점(강남점)과 3위 지점(성수점) 간의 총 판매금액은 약 1.77배 차이가 납니다. 이는 강남점의 강력한 시장 지배력 또는 높은 고객 유입을 시사합니다.\n","\n","### 2. 월별 총 판매금액 추이\n","- 2026년 2월(240,125원)에서 3월(806,350원)로 판매금액이 3.36배 급등했습니다. 이는 특정 이벤트, 프로모션, 계절적 요인 또는 신제품 출시 등의 영향으로 보입니다. 다른 월에는 비교적 안정적인 판매량을 보입니다.\n","\n","### 3. 판매금액 분포\n","- **최다 구간:** 3,827원 ~ 26,325원 (총 205건의 판매 발생).\n","- **고액 판매:** 25,000원을 초과하는 판매는 총 19건으로, 전체 판매 건수 중 작은 비중을 차지하지만 높은 단가의 메뉴 또는 단체 주문이 있었음을 나타냅니다.\n","\n","### 4. 지점별 중앙값 및 이상치\n","- **강남점:** 중앙값 9,900원, 이상치 10건\n","- **마포점:** 중앙값 8,325원, 이상치 6건\n","- **성수점:** 중앙값 9,000원, 이상치 4건\n","\n","각 지점 모두 평균 판매금액과 중앙값에 차이가 있으며, 이상치 건수가 발견되었습니다. 이는 특정 지점에서 고액 주문 또는 특이 판매가 더 자주 발생했음을 의미합니다.\n","\n","### 5. 단가와 수량의 상관관계\n","- **상관계수:** 0.046\n","- **수량 1~3개 주문:** 199건\n","\n","단가와 수량 간의 상관계수가 0.046으로 매우 낮아, 단가가 높다고 해서 주문 수량이 늘거나 줄어드는 직접적인 경향은 없습니다. 대부분의 주문은 1~3개의 소량 주문입니다."]},{"cell_type":"markdown","metadata":{"id":"9b4f4c36"},"source":["## 💡 주요 발견\n","\n","1.  **강남점의 독보적인 성과:** 강남점은 다른 지점들에 비해 월등히 높은 총 판매금액을 기록하고 있습니다. 이는 강남점의 성공 요인을 분석하여 다른 지점들에 적용할 필요가 있음을 시사합니다.\n","2.  **3월 판매 급등의 원인 파악 필요:** 2월 대비 3월의 판매가 3배 이상 급증한 원인을 심층 분석하여, 해당 요인을 다른 시기나 지점에도 적용할 수 있는 방안을 모색해야 합니다.\n","3.  **판매금액 집중 구간과 고액 판매:** 대부분의 판매는 특정 가격대에 집중되어 있지만, 소수의 고액 판매 건이 전체 매출에 미치는 영향도 고려해야 합니다.\n","4.  **지점별 이상치 관리:** 이상치 판매 건은 특별한 고객(단체 주문 등)이나 상품과 관련될 수 있으므로, 이들에 대한 추가 분석을 통해 고객 분류 및 맞춤형 마케팅 전략 수립에 활용할 수 있습니다.\n","5.  **단가-수량 비례 관계 부족:** 단가와 수량은 서로 독립적인 경향을 보이므로, 메뉴 구성 및 가격 전략 수립 시 이를 고려해야 합니다. 예를 들어, 저가 메뉴로 대량 판매를 유도하기보다는 각 메뉴의 품질과 고객 경험에 집중하는 전략이 유효할 수 있습니다."]},{"cell_type":"markdown","metadata":{"id":"8294c9ec"},"source":["## 📝 추천 사항\n","\n","1.  **강남점 성공 사례 분석 및 확산:** 강남점의 높은 매출을 이끄는 요인(메뉴 구성, 프로모션, 서비스, 위치적 특성 등)을 구체적으로 분석하고, 이를 마포점과 성수점에 적용하여 전체적인 매출 상향 평준화를 도모해야 합니다.\n","2.  **3월 급등 요인 활용:** 3월 매출 급등의 원인을 파악한 후, 이를 바탕으로 연간 마케팅 계획에 반영할 수 있는 성공적인 프로모션이나 이벤트 전략을 개발하고 실행합니다.\n","3.  **고액 판매 분석 및 VIP 전략:** 25,000원 초과 판매 건의 특징(메뉴, 고객 유형, 주문 시간 등)을 분석하여 VIP 고객을 위한 특별 메뉴 개발 또는 단체 주문 유치 전략을 수립합니다.\n","4.  **지점별 이상치 심층 분석:** 각 지점의 이상치 발생 원인을 분석하여, 이를 통해 해당 지점의 특성을 이해하고 맞춤형 재고 관리, 메뉴 추천 또는 고객 서비스를 강화할 수 있습니다.\n","5.  **다양한 판매 전략 모색:** 단가와 수량의 낮은 상관관계를 고려하여, 세트 메뉴 개발, 시간대별 할인 프로모션, 고객 유형별 맞춤형 추천 등 판매 증대를 위한 다각적인 접근 방식을 시도해 볼 수 있습니다."]}]}